# Line endings are normalised to LF everywhere so that scripts run under Git
# Bash on Windows and test vectors keep the digest they were recorded with.
* text=auto eol=lf
tests/vectors/** -text
# The scanner pin keeps upstream files whose signature must keep matching, byte for byte.
src/iltero_schemas/scanners/common/*.json -text
src/iltero_schemas/scanners/common/*.txt -text
src/iltero_schemas/scanners/common/locks/** -text
# A saved plan file is a zip archive, kept byte for byte so its digest is the one its record names.
src/iltero_schemas/vectors/saved_plans/** -text
