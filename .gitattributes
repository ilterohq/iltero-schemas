# Line endings are normalised to LF everywhere so that scripts run under Git
# Bash on Windows and test vectors keep the digest they were recorded with.
* text=auto eol=lf
tests/vectors/** -text
# The scanner pin keeps upstream files whose signature must keep matching, byte for byte.
src/iltero_schemas/scanners/*.json -text
src/iltero_schemas/scanners/*.txt -text
src/iltero_schemas/scanners/locks/** -text
