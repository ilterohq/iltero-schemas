{
  "assert": {
    "any": [
      {
        "exists": {
          "in": "approvals",
          "where": {
            "all": [
              {
                "predicate": {
                  "literal": "approved",
                  "op": "equal",
                  "path": "item.status"
                }
              },
              {
                "predicate": {
                  "literal": "change",
                  "op": "equal",
                  "path": "item.subject.kind"
                }
              },
              {
                "predicate": {
                  "op": "equal",
                  "path": "item.subject.digest",
                  "ref": "change.digest"
                }
              },
              {
                "predicate": {
                  "literal": "security",
                  "op": "contains",
                  "path": "item.roles"
                }
              },
              {
                "predicate": {
                  "literal": "independent",
                  "op": "equal",
                  "path": "item.independence"
                }
              }
            ]
          }
        }
      },
      {
        "exists": {
          "in": "approvals",
          "where": {
            "all": [
              {
                "predicate": {
                  "literal": "approved",
                  "op": "equal",
                  "path": "item.status"
                }
              },
              {
                "predicate": {
                  "literal": "run",
                  "op": "equal",
                  "path": "item.subject.kind"
                }
              },
              {
                "predicate": {
                  "op": "equal",
                  "path": "item.subject.id",
                  "ref": "run.id"
                }
              }
            ]
          }
        }
      }
    ]
  },
