{
  "ast_version": 2,
  "id": "ILT.CHANGE.SENSITIVE_CHANGE_APPROVED",
  "version": "1.0.0",
  "type": "process",
  "stage": "pre_deploy",
  "target": {
    "kind": "change"
  },
  "when": {
    "exists": {
      "in": "change.resources",
      "where": {
        "predicate": {
          "path": "item.type",
          "op": "in",
          "literal": [
            "aws_iam_policy",
            "aws_iam_role_policy",
            "aws_security_group",
            "aws_security_group_rule",
            "aws_kms_key"
          ]
        }
      }
    }
  },
  "assert": {
    "any": [
      {
        "exists": {
          "in": "approvals",
          "where": {
            "all": [
              {
                "predicate": {
                  "path": "item.status",
                  "op": "equal",
                  "literal": "approved"
                }
              },
              {
                "predicate": {
                  "path": "item.subject.kind",
                  "op": "equal",
                  "literal": "change"
                }
              },
              {
                "predicate": {
                  "path": "item.subject.digest",
                  "op": "equal",
                  "ref": "change.digest"
                }
              },
              {
                "predicate": {
                  "path": "item.roles",
                  "op": "contains",
                  "literal": "security"
                }
              },
              {
                "predicate": {
                  "path": "item.independence",
                  "op": "equal",
                  "literal": "independent"
                }
              }
            ]
          }
        }
      },
      {
        "exists": {
          "in": "approvals",
          "where": {
            "all": [
              {
                "predicate": {
                  "path": "item.status",
                  "op": "equal",
                  "literal": "approved"
                }
              },
              {
                "predicate": {
                  "path": "item.subject.kind",
                  "op": "equal",
                  "literal": "run"
                }
              },
              {
                "predicate": {
                  "path": "item.subject.id",
                  "op": "equal",
                  "ref": "run.id"
                }
              }
            ]
          }
        }
      }
    ]
  }
}
