{
  "ast_version": 2,
  "id": "ILT.CHANGE.SENSITIVE_CHANGE_APPROVED",
  "version": "1.0.0",
  "type": "process",
  "stage": "pre_deploy",
  "target": {
    "kind": "change",
    "resources": [
      {
        "provider": "aws",
        "kinds": [
          "iam_access_key",
          "iam_group_membership",
          "iam_group_policy",
          "iam_identity_provider",
          "iam_policy",
          "iam_policy_attachment",
          "iam_role",
          "iam_role_policy",
          "iam_user_policy",
          "kms_grant",
          "kms_key",
          "kms_key_policy",
          "network_acl",
          "network_acl_rule",
          "security_group",
          "security_group_rule"
        ]
      }
    ]
  },
  "when": null,
  "assert": {
    "any": [
      {
        "exists": {
          "in": "approvals",
          "where": {
            "all": [
              {
                "predicate": {
                  "path": "item.status",
                  "op": "equal",
                  "literal": "approved"
                }
              },
              {
                "predicate": {
                  "path": "item.subject.kind",
                  "op": "equal",
                  "literal": "change"
                }
              },
              {
                "predicate": {
                  "path": "item.subject.digest",
                  "op": "equal",
                  "ref": "change.digest"
                }
              },
              {
                "predicate": {
                  "path": "item.roles",
                  "op": "contains",
                  "literal": "security"
                }
              },
              {
                "predicate": {
                  "path": "item.independence",
                  "op": "equal",
                  "literal": "independent"
                }
              }
            ]
          }
        }
      },
      {
        "exists": {
          "in": "approvals",
          "where": {
            "all": [
              {
                "predicate": {
                  "path": "item.status",
                  "op": "equal",
                  "literal": "approved"
                }
              },
              {
                "predicate": {
                  "path": "item.subject.kind",
                  "op": "equal",
                  "literal": "run"
                }
              },
              {
                "predicate": {
                  "path": "item.subject.id",
                  "op": "equal",
                  "ref": "run.id"
                }
              }
            ]
          }
        }
      }
    ]
  }
}
