{
  "ast_version": 1,
  "id": "VEC.OPS.ORDERING",
  "version": "1.0.0",
  "type": "state",
  "stage": "plan",
  "target": {
    "kind": "resource",
    "provider": "vec",
    "resource_types": [
      "thing"
    ]
  },
  "when": null,
  "assert": {
    "all": [
      {
        "predicate": {
          "path": "resource.after.n",
          "op": "greater_than",
          "literal": 1
        }
      },
      {
        "predicate": {
          "path": "resource.after.n",
          "op": "greater_than_or_equal",
          "literal": 2
        }
      },
      {
        "predicate": {
          "path": "resource.after.n",
          "op": "less_than",
          "literal": 3
        }
      },
      {
        "predicate": {
          "path": "resource.after.n",
          "op": "less_than_or_equal",
          "literal": 2
        }
      },
      {
        "predicate": {
          "path": "resource.after.t",
          "op": "greater_than",
          "literal": "2026-01-01T00:00:00.000Z"
        }
      },
      {
        "predicate": {
          "path": "resource.after.t",
          "op": "less_than",
          "ref": "reference_time.value"
        }
      }
    ]
  }
}
