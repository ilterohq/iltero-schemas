{
  "description": "Each case evaluates one assertion over contexts/iac/pre_deploy_change.json. With unknown_marker the server facts are the markers the vector holds; with empty_list each is replaced by []. A missing fact must give unknown, never fail, which is why the facts carry a marker and not an empty list.",
  "context": "iac/pre_deploy_change.json",
  "cases": [
    {
      "name": "production_approved_unknown_marker",
      "assertion": "ILT.COMMON.CHANGE.APPROVAL.PRODUCTION_APPROVED",
      "facts": "unknown_marker",
      "expected": {
        "status": "unknown",
        "reason": "approvals: server_facts_unavailable",
        "unknown": {
          "path": "approvals",
          "reason": "server_facts_unavailable"
        },
        "when": "true"
      }
    },
    {
      "name": "production_approved_empty_list",
      "assertion": "ILT.COMMON.CHANGE.APPROVAL.PRODUCTION_APPROVED",
      "facts": "empty_list",
      "expected": {
        "status": "fail",
        "reason": "assert: false; approvals exists is false",
        "unknown": null,
        "when": "true"
      }
    },
    {
      "name": "sensitive_change_approved_unknown_marker",
      "assertion": "ILT.IAC.CHANGE.APPROVAL.SENSITIVE_CHANGE_APPROVED",
      "facts": "unknown_marker",
      "expected": {
        "status": "unknown",
        "reason": "approvals: server_facts_unavailable",
        "unknown": {
          "path": "approvals",
          "reason": "server_facts_unavailable"
        },
        "when": "true"
      }
    },
    {
      "name": "sensitive_change_approved_empty_list",
      "assertion": "ILT.IAC.CHANGE.APPROVAL.SENSITIVE_CHANGE_APPROVED",
      "facts": "empty_list",
      "expected": {
        "status": "fail",
        "reason": "assert: false; approvals exists is false",
        "unknown": null,
        "when": "true"
      }
    }
  ]
}
