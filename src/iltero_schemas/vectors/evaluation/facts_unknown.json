{
  "description": "Each case evaluates one assertion over contexts/iac/pre_deploy_change.json. With unknown_marker the server facts are the markers the vector holds; with empty_list each is replaced by []. A missing fact must give unknown, never fail, which is why the facts carry a marker and not an empty list.",
  "context": "iac/pre_deploy_change.json",
  "cases": [
    {
      "name": "production_approved_unknown_marker",
      "assertion": "ILT.COMMON.CHANGE.APPROVAL.PRODUCTION_APPROVED",
      "facts": "unknown_marker",
      "expected": {
        "status": "unknown",
        "reason": "approvals: server_facts_unavailable",
        "unknown": {
          "path": "approvals",
          "reason": "server_facts_unavailable"
        },
        "when": "true"
      }
    },
    {
      "name": "production_approved_empty_list",
      "assertion": "ILT.COMMON.CHANGE.APPROVAL.PRODUCTION_APPROVED",
      "facts": "empty_list",
      "expected": {
        "status": "fail",
        "reason": "assert: false; approvals exists is false",
        "unknown": null,
        "when": "true"
      }
    },
    {
      "name": "sensitive_change_approved_unknown_marker",
      "assertion": "ILT.IAC.CHANGE.APPROVAL.SENSITIVE_CHANGE_APPROVED",
      "facts": "unknown_marker",
      "expected": {
        "status": "unknown",
        "reason": "approvals: server_facts_unavailable",
        "unknown": {
          "path": "approvals",
          "reason": "server_facts_unavailable"
        },
        "when": "true"
      }
    },
    {
      "name": "sensitive_change_approved_empty_list",
      "assertion": "ILT.IAC.CHANGE.APPROVAL.SENSITIVE_CHANGE_APPROVED",
      "facts": "empty_list",
      "expected": {
        "status": "fail",
        "reason": "assert: false; approvals exists is false",
        "unknown": null,
        "when": "true"
      }
    },
    {
      "name": "approved_after_plan_stage_record_accepted_unknown_marker",
      "assertion": "ILT.IAC.CHANGE.APPROVAL.APPROVED_AFTER_PLAN_STAGE_RECORD_ACCEPTED",
      "facts": "unknown_marker",
      "expected": {
        "status": "unknown",
        "reason": "apply_job_facts.flow: server_facts_unavailable",
        "unknown": {
          "path": "apply_job_facts.flow",
          "reason": "server_facts_unavailable"
        },
        "when": "unknown"
      }
    },
    {
      "name": "evaluated_plan_is_pinned_plan_unknown_marker",
      "assertion": "ILT.IAC.CHANGE.CONTENT.EVALUATED_PLAN_IS_PINNED_PLAN",
      "facts": "unknown_marker",
      "expected": {
        "status": "unknown",
        "reason": "apply_job_facts.pinned_plan_digest: server_facts_unavailable",
        "unknown": {
          "path": "apply_job_facts.pinned_plan_digest",
          "reason": "server_facts_unavailable"
        },
        "when": null
      }
    },
    {
      "name": "received_plan_file_matches_evaluated_plan_file_unknown_marker",
      "assertion": "ILT.IAC.CHANGE.CONTENT.RECEIVED_PLAN_FILE_MATCHES_EVALUATED_PLAN_FILE",
      "facts": "unknown_marker",
      "expected": {
        "status": "unknown",
        "reason": "apply_job_facts.flow: server_facts_unavailable",
        "unknown": {
          "path": "apply_job_facts.flow",
          "reason": "server_facts_unavailable"
        },
        "when": "unknown"
      }
    },
    {
      "name": "rendered_plan_matches_evaluated_plan_unknown_marker",
      "assertion": "ILT.IAC.CHANGE.CONTENT.RENDERED_PLAN_MATCHES_EVALUATED_PLAN",
      "facts": "unknown_marker",
      "expected": {
        "status": "unknown",
        "reason": "apply_job_facts.flow: server_facts_unavailable",
        "unknown": {
          "path": "apply_job_facts.flow",
          "reason": "server_facts_unavailable"
        },
        "when": "unknown"
      }
    },
    {
      "name": "plan_age_within_limit_unknown_marker",
      "assertion": "ILT.IAC.CHANGE.TIMING.PLAN_AGE_WITHIN_LIMIT",
      "facts": "unknown_marker",
      "expected": {
        "status": "unknown",
        "reason": "apply_job_timing.plan_age_seconds: server_facts_unavailable",
        "unknown": {
          "path": "apply_job_timing.plan_age_seconds",
          "reason": "server_facts_unavailable"
        },
        "when": null
      }
    },
    {
      "name": "replan_has_same_actions_as_evaluated_plan_unknown_marker",
      "assertion": "ILT.IAC.CHANGE.CONTENT.REPLAN_HAS_SAME_ACTIONS_AS_EVALUATED_PLAN",
      "facts": "unknown_marker",
      "expected": {
        "status": "unknown",
        "reason": "apply_job_facts.flow: server_facts_unavailable",
        "unknown": {
          "path": "apply_job_facts.flow",
          "reason": "server_facts_unavailable"
        },
        "when": "unknown"
      }
    }
  ]
}
