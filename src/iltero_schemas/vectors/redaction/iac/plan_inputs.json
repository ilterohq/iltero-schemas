{
  "cases": [
    {
      "name": "terraform_plan_with_each_kind_of_mark",
      "description": "A plan with a declared sensitive attribute, a value known only after the deployment, a sensitive variable and output, provider settings, a provisioner and a configured resource with no instance: the marks and anchors its reader gives, and the plan redacted with them under a policy that hides tags.owner.",
      "tool": "terraform",
      "policy": {
        "id": "iltero.redaction",
        "version": "1",
        "additional_paths": [
          "tags.owner"
        ],
        "exempt_paths": []
      },
      "plan": {
        "format_version": "1.2",
        "terraform_version": "1.14.0",
        "variables": {
          "db_password": {
            "value": "s3cret-value-long"
          }
        },
        "planned_values": {
          "root_module": {
            "resources": [
              {
                "address": "aws_db_instance.main",
                "mode": "managed",
                "type": "aws_db_instance",
                "name": "main",
                "provider_name": "registry.terraform.io/hashicorp/aws",
                "values": {
                  "password": "s3cret-value-long",
                  "engine": "postgres"
                },
                "sensitive_values": {
                  "password": true
                }
              }
            ]
          },
          "outputs": {
            "connection": {
              "sensitive": true,
              "value": "postgres://app:hidden-value@db.internal/app"
            }
          }
        },
        "resource_changes": [
          {
            "address": "aws_db_instance.main",
            "mode": "managed",
            "type": "aws_db_instance",
            "name": "main",
            "provider_name": "registry.terraform.io/hashicorp/aws",
            "change": {
              "actions": [
                "create"
              ],
              "before": null,
              "after": {
                "password": "s3cret-value-long",
                "engine": "postgres",
                "tags": {
                  "owner": "team-a"
                }
              },
              "after_unknown": {
                "arn": true
              },
              "before_sensitive": false,
              "after_sensitive": {
                "password": true
              }
            }
          }
        ],
        "output_changes": {
          "connection": {
            "actions": [
              "create"
            ],
            "before": null,
            "after": "postgres://app:hidden-value@db.internal/app",
            "after_unknown": false,
            "before_sensitive": false,
            "after_sensitive": true
          }
        },
        "configuration": {
          "provider_config": {
            "aws": {
              "name": "aws",
              "expressions": {
                "region": {
                  "constant_value": "eu-west-1"
                },
                "secret_key": {
                  "constant_value": "placeholder-value"
                }
              }
            }
          },
          "root_module": {
            "variables": {
              "db_password": {
                "sensitive": true
              }
            },
            "outputs": {
              "connection": {
                "sensitive": true,
                "expression": {
                  "references": [
                    "aws_db_instance.main.endpoint"
                  ]
                }
              }
            },
            "resources": [
              {
                "address": "aws_db_instance.main",
                "mode": "managed",
                "type": "aws_db_instance",
                "name": "main",
                "expressions": {
                  "password": {
                    "references": [
                      "var.db_password"
                    ]
                  },
                  "engine": {
                    "constant_value": "postgres"
                  }
                },
                "provisioners": [
                  {
                    "type": "local-exec",
                    "expressions": {
                      "command": {
                        "constant_value": "echo done"
                      }
                    }
                  }
                ]
              },
              {
                "address": "aws_s3_bucket.unplanned",
                "mode": "managed",
                "type": "aws_s3_bucket",
                "name": "unplanned",
                "expressions": {
                  "bucket": {
                    "constant_value": "logs"
                  }
                },
                "count_expression": {
                  "constant_value": 0
                }
              }
            ]
          }
        }
      }
    },
    {
      "name": "terraform_plan_with_rendering_metadata_and_a_sensitive_value_copied_where_it_is_not_marked",
      "description": "A plan rendered at a time, from a prior state, whose declared sensitive variable the provider also copied into tags_all, which the plan does not mark sensitive: the kept plan hides that copy as a reuse of a sensitive value, and its digest drops the rendering metadata.",
      "tool": "terraform",
      "policy": {
        "id": "iltero.redaction",
        "version": "1",
        "additional_paths": [],
        "exempt_paths": []
      },
      "plan": {
        "format_version": "1.2",
        "terraform_version": "1.14.0",
        "timestamp": "2026-09-22T13:00:00Z",
        "prior_state": {
          "format_version": "1.0",
          "values": {
            "root_module": {}
          }
        },
        "variables": {
          "deploy_token": {
            "value": "copied-secret-value"
          }
        },
        "resource_changes": [
          {
            "address": "aws_s3_bucket.logs",
            "mode": "managed",
            "type": "aws_s3_bucket",
            "name": "logs",
            "provider_name": "registry.terraform.io/hashicorp/aws",
            "change": {
              "actions": [
                "create"
              ],
              "before": null,
              "after": {
                "bucket": "acme-logs",
                "tags": {
                  "token": "copied-secret-value"
                },
                "tags_all": {
                  "token": "copied-secret-value"
                }
              },
              "after_unknown": {
                "arn": true
              },
              "before_sensitive": false,
              "after_sensitive": {
                "tags": {
                  "token": true
                }
              }
            }
          }
        ],
        "configuration": {
          "root_module": {
            "variables": {
              "deploy_token": {
                "sensitive": true
              }
            },
            "resources": [
              {
                "address": "aws_s3_bucket.logs",
                "mode": "managed",
                "type": "aws_s3_bucket",
                "name": "logs",
                "expressions": {
                  "tags": {
                    "references": [
                      "var.deploy_token"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
